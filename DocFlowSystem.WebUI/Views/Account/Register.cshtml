@model DocFlowSystem.WebUI.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "تسجيل مستخدم جديد";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h3>إضافة مستخدم جديد</h3>
            </div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">كلمة المرور</label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">الصلاحية (الدور)</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Employee">موظف (Employee)</option>
                            <option value="Manager">رئيس فرع / مدير (Manager)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success flex-fill">حفظ وإنشاء</button>
                        <a asp-controller="Documents" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                            ⬅️ رجوع للسجل
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>